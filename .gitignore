# --- Dossier de configuration JetBrains / DataGrip ---
.idea/

# --- Si vous souhaitez partager certains paramètres du projet mais ignorer les données sensibles ---
# Décommentez les lignes ci-dessous et commentez ".idea/" ci-dessus :
# .idea/*
# !.idea/dataSources.xml
# .idea/dataSources.local.xml
# .idea/workspace.xml
# .idea/tasks.xml
# .idea/usage.statistics.xml
# .idea/dictionaries
# .idea/shelf

# --- Consoles SQL temporaires et historique ---
consoles/
scratches/

# --- Dumps, exports et fichiers de bases de données locales ---
*.sql.gz
*.dump
*.bak
*.sqlite
*.sqlite3
*.db

# --- Fichiers système (Windows / macOS / Linux) ---
.DS_Store
Thumbs.db
desktop.ini
